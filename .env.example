# --- Core ---
DATABASE_URL=postgres://localhost:5432/lion_safari
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# Secret used to sign staff session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-32-byte-random-string

# --- Pricing (all money is stored and configured in PAISE, never rupees) ---
# 500.00 INR per visitor
TICKET_PRICE_PAISE=50000
# Convenience fee charged on ONLINE bookings only, per booking. Must be disclosed in UI.
CONVENIENCE_FEE_PAISE=2000

# --- Operations ---
# All visit dates / business days are computed in this timezone, never the device's.
APP_TIMEZONE=Asia/Kolkata
# Scanner shows a prominent warning when its last successful sync is older than this.
SYNC_STALE_THRESHOLD_SECONDS=300
# How long a PENDING online booking waits before reconciliation polls the provider.
# Keep 5 in production (let the webhook win). Set 1 locally, where webhooks cannot
# reach localhost and reconciliation is what confirms the booking.
RECONCILE_MIN_AGE_MINUTES=5

# --- Cashfree (payments) ---
# SANDBOX or PRODUCTION
CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Cashfree signs webhooks with the client secret of the same environment.
CASHFREE_WEBHOOK_SECRET=

# --- Email delivery (Resend) ---
RESEND_API_KEY=
MAIL_FROM="Lion Safari <tickets@example.com>"
SUPPORT_PHONE=+91-00000-00000
