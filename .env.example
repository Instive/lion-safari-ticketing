# --- Core ---
DATABASE_URL=postgres://localhost:5432/lion_safari
# The public, customer-facing origin.
APP_BASE_URL=http://localhost:3000
# The staff operations origin. Leave unset (or commented out) to serve staff and
# customer pages from one host, which is how local development works by default.
# When set, staff paths (/login /counter /admin /scanner /api/scanner) serve ONLY
# from this host and 404 on APP_BASE_URL, and vice versa. `*.localhost` resolves
# to loopback in modern browsers, so one `npm run dev` can serve both:
# STAFF_BASE_URL=http://staff.localhost:3000
NODE_ENV=development
# Which deployment this is: local | dev | production.
#
# Defaults to `production` when unset, deliberately: `db:seed`, `db:seed:demo`
# and every `verify:*` script rewrite data and refuse to run unless this says
# the environment is NOT production. Forgetting it can therefore never be the
# reason the live database gets overwritten.
APP_ENV=local

# Secret used to sign staff session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-32-byte-random-string

# --- Pricing (all money is stored and configured in PAISE, never rupees) ---
# 75.00 INR per visitor
TICKET_PRICE_PAISE=7500
# Convenience fee charged on ONLINE bookings only, per booking. Must be disclosed in UI.
CONVENIENCE_FEE_PAISE=0

# --- Operations ---
# All visit dates / business days are computed in this timezone, never the device's.
APP_TIMEZONE=Asia/Kolkata
# Scanner shows a prominent warning when its last successful sync is older than this.
SYNC_STALE_THRESHOLD_SECONDS=300
# How long a PENDING online booking waits before reconciliation polls the provider.
# Keep 5 in production (let the webhook win). Set 1 locally, where webhooks cannot
# reach localhost and reconciliation is what confirms the booking.
RECONCILE_MIN_AGE_MINUTES=5

# --- Cashfree (payments) ---
# SANDBOX or PRODUCTION
CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Cashfree signs webhooks with the client secret of the same environment.
CASHFREE_WEBHOOK_SECRET=

# --- Email delivery (Brevo) ---
BREVO_API_KEY=
# Must be an address on a domain verified in Brevo, or sends fail.
MAIL_FROM="Lion Safari <tickets@example.com>"
SUPPORT_PHONE=+91-00000-00000

# --- Daily bookings report ---
# Comma-separated recipients of the 8:00 PM (APP_TIMEZONE) bookings CSV. Each
# evening's email is an off-site copy of the day's booking record; leave unset
# and the job runs but sends nothing.
REPORT_EMAIL_TO=chhatbir.lionsafari@gmail.com

# Run the background jobs inside the web process instead of a separate worker
# service. Leave unset (false) to run `npm run worker` as its own process, which
# is what local development and the default Render blueprint expect.
#
# Setting this to true on a single-instance deployment lets you delete the
# worker service entirely — see the note in src/lib/env.ts for the tradeoff.
RUN_WORKER_IN_WEB=false
